{
	"groups": {
	  "group:database-administrators": ["tailyandscaly@gmail.com"],
	},

	"tagOwners": {
	 	"tag:database": ["group:database-administrators"],
		"tag:border0-managed": ["autogroup:admin"],
	},

	"autoApprovers": {"services": {"tag:border0-managed": ["tag:border0-managed"]}},

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	"grants": [
	  // All members can access their own devices
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["tcp:*"],
		},

		{
  		"src": ["group:database-administrators"],
  		"dst": ["tag:database"],
      "ip":  ["tcp:22"]
		}

		// Automatically added by enabling PAM. This grants access to every user with the "Admin" role for all PAM services.
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:border0-managed"],
			"ip":  ["*"],

			"app": {
				"tailscale.com/cap/pam": [
					{
						"version": "v1",

						"permissions": {
							"ssh": {
								"shell": {},
								"exec":  {},
								"sftp":  {},
							},

							"database":   {},
							"http":       {},
							"rdp":        {},
							"vnc":        {},
							"tcp":        {},
							"kubernetes": {},
							"aws_s3":     {},
						},
					},
				],
			},
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},

		{
		  "action": "check",
			"src": ["group:database-administrators"],
			"dst": ["tag:database"],
			"users": ["ubuntu", "root"]
		}
	],
}
