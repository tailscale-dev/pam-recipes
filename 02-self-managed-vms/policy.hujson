/*
This policy file models a simple database access pattern. We have a tier-1 support
group who have read-only access to our customer database. The on-call group has
full read/write access to the database.

By moving users between the groups we can see their access change in real-time.
*/
{
	"groups": {
		"group:tier-1-support": ["tailyandscaly@gmail.com"],
		"group:on-call": [],
	},

	"tagOwners": {
		"tag:database":        [],
		"tag:border0-managed": ["autogroup:admin"],
	},

	"autoApprovers": {"services": {"tag:border0-managed": ["tag:border0-managed"]}},

	"grants": [
		// All members can access their own devices
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["tcp:*"],
		},

        // On-call engineers can SSH into database host machines
		{
			"src": ["group:on-call"],
			"dst": ["tag:database"],
			"ip":  ["tcp:22"],
		},

        // Tier 1 support agents get read-only access to all databases on the
        // customer-database instance.
		{
			"src": ["group:tier-1-support"],
			"dst": ["svc:customer-database"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/pam": [
					{
						"version": "v1",
						"permissions": {
							"database": {
								"allowed_databases": [
									{
										"database":            "*",
										"allowed_query_types": ["ReadOnly"],
									},
								],
							},
						},
					},
				],
			},
		},

		// On-call engineers can make changes to all databases on the
		// customer-database instance.
		{
			"src": ["group:on-call"],
			"dst": ["svc:customer-database"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/pam": [
					{
						"version": "v1",
						"permissions": {
							"database": {
								"allowed_databases": [
									{
										"database":            "*",
										"allowed_query_types": ["ReadWrite"],
									},
								],
							},
						},
					},
				],
			},
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},

        // Allow on-call users to SSH into the database host node
		{
			"action": "check",
			"src":    ["group:on-call"],
			"dst":    ["tag:database"],
			"users":  ["ubuntu", "root"],
		},
	],
}
